{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowTitle": "Ajuste de inventario",
	"events": [
		"onLoad"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"titulo": {
					"type": "text",
					"text": "Ajuste de inventario",
					"left": 10,
					"top": 8,
					"width": 300,
					"height": 26,
					"fontWeight": "bold",
					"fontSize": 16
				},
				"iNumero": {
					"type": "input",
					"dataSource": "Form.numero",
					"dataSourceTypeHint": "text",
					"left": 320,
					"top": 10,
					"width": 350,
					"height": 22,
					"enterable": false
				},
				"lFecha": {
					"type": "text",
					"text": "Fecha:",
					"left": 700,
					"top": 12,
					"width": 50,
					"height": 20
				},
				"iFecha": {
					"type": "input",
					"dataSource": "Form.fecha",
					"dataSourceTypeHint": "date",
					"left": 755,
					"top": 10,
					"width": 130,
					"height": 22,
					"enterable": true
				},
				"lMotivo": {
					"type": "text",
					"text": "Motivo:",
					"left": 10,
					"top": 52,
					"width": 170,
					"height": 20
				},
				"iMotivo": {
					"type": "input",
					"dataSource": "Form.motivo",
					"dataSourceTypeHint": "text",
					"left": 185,
					"top": 50,
					"width": 500,
					"height": 22,
					"enterable": true
				},
				"lTipo": {
					"type": "text",
					"text": "Tipo de las nuevas líneas:",
					"left": 10,
					"top": 86,
					"width": 170,
					"height": 20
				},
				"bTipo": {
					"type": "button",
					"text": "Elegir...",
					"left": 185,
					"top": 82,
					"width": 90,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/bTipo.4dm"
				},
				"iTipo": {
					"type": "input",
					"dataSource": "Form.tipo",
					"dataSourceTypeHint": "text",
					"left": 280,
					"top": 84,
					"width": 120,
					"height": 22,
					"enterable": false
				},
				"lCod": {
					"type": "text",
					"text": "Código / barras:",
					"left": 10,
					"top": 120,
					"width": 170,
					"height": 20
				},
				"iCodigo": {
					"type": "input",
					"dataSource": "Form.codigo",
					"dataSourceTypeHint": "text",
					"left": 185,
					"top": 118,
					"width": 200,
					"height": 22,
					"enterable": true,
					"events": [
						"onDataChange"
					],
					"method": "ObjectMethods/iCodigo.4dm"
				},
				"bAgregar": {
					"type": "button",
					"text": "Agregar",
					"left": 395,
					"top": 116,
					"width": 90,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/bAgregar.4dm"
				},
				"lbLineas": {
					"type": "listbox",
					"left": 10,
					"top": 152,
					"width": 875,
					"height": 300,
					"dataSource": "Form.lineas",
					"listboxType": "collection",
					"currentItemSource": "Form.lineaActual",
					"selectionMode": "single",
					"events": [
						"onDataChange"
					],
					"columns": [
						{
							"name": "k0",
							"dataSource": "This.codigo",
							"width": 110,
							"header": {
								"name": "hk0",
								"text": "Código"
							}
						},
						{
							"name": "k1",
							"dataSource": "This.nombre",
							"width": 330,
							"header": {
								"name": "hk1",
								"text": "Producto"
							}
						},
						{
							"name": "k2",
							"dataSource": "This.tipo",
							"width": 90,
							"header": {
								"name": "hk2",
								"text": "Tipo"
							}
						},
						{
							"name": "k3",
							"dataSource": "This.cantidad",
							"width": 90,
							"dataSourceTypeHint": "number",
							"enterable": true,
							"header": {
								"name": "hk3",
								"text": "Cantidad"
							}
						},
						{
							"name": "k4",
							"dataSource": "This.precio",
							"width": 110,
							"dataSourceTypeHint": "number",
							"header": {
								"name": "hk4",
								"text": "Costo unit."
							}
						},
						{
							"name": "k5",
							"dataSource": "This.total",
							"width": 120,
							"dataSourceTypeHint": "number",
							"header": {
								"name": "hk5",
								"text": "Valor"
							}
						}
					],
					"method": "ObjectMethods/lbLineas.4dm"
				},
				"bCambiarTipo": {
					"type": "button",
					"text": "Cambiar tipo",
					"left": 10,
					"top": 470,
					"width": 120,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/bCambiarTipo.4dm"
				},
				"bQuitar": {
					"type": "button",
					"text": "Quitar línea",
					"left": 140,
					"top": 470,
					"width": 110,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/bQuitar.4dm"
				},
				"bRegistrar": {
					"type": "button",
					"text": "Aplicar ajuste",
					"left": 260,
					"top": 470,
					"width": 140,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/bRegistrar.4dm"
				},
				"bCerrar": {
					"type": "button",
					"text": "Cerrar",
					"left": 410,
					"top": 470,
					"width": 100,
					"height": 26,
					"events": [
						"onClick"
					],
					"action": "cancel"
				}
			}
		}
	],
	"method": "method.4dm"
}