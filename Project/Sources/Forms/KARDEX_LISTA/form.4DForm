{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowTitle": "Kardex (movimientos de inventario)",
	"events": [
		"onLoad"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"titulo": {
					"type": "text",
					"text": "Kardex (movimientos de inventario)",
					"left": 10,
					"top": 8,
					"width": 400,
					"height": 26,
					"fontWeight": "bold",
					"fontSize": 16
				},
				"lblBus": {
					"type": "text",
					"text": "Producto:",
					"left": 540,
					"top": 14,
					"width": 80,
					"height": 20
				},
				"iBuscar": {
					"type": "input",
					"dataSource": "Form.texto",
					"dataSourceTypeHint": "text",
					"left": 625,
					"top": 12,
					"width": 265,
					"height": 22,
					"enterable": true,
					"events": [
						"onDataChange"
					],
					"method": "ObjectMethods/iBuscar.4dm"
				},
				"lb": {
					"type": "listbox",
					"left": 10,
					"top": 50,
					"width": 880,
					"height": 450,
					"dataSource": "Form.lista",
					"listboxType": "collection",
					"currentItemSource": "Form.actual",
					"selectionMode": "single",
					"columns": [
						{
							"name": "c0",
							"dataSource": "This.Fecha",
							"width": 85,
							"header": {
								"name": "hc0",
								"text": "Fecha"
							}
						},
						{
							"name": "c1",
							"dataSource": "This.inventario.Codigo",
							"width": 90,
							"header": {
								"name": "hc1",
								"text": "Código"
							}
						},
						{
							"name": "c2",
							"dataSource": "This.inventario.Nombre",
							"width": 220,
							"header": {
								"name": "hc2",
								"text": "Producto"
							}
						},
						{
							"name": "c3",
							"dataSource": "This.Tipo",
							"width": 70,
							"header": {
								"name": "hc3",
								"text": "Tipo"
							}
						},
						{
							"name": "c4",
							"dataSource": "This.Cantidad",
							"width": 70,
							"header": {
								"name": "hc4",
								"text": "Cantidad"
							}
						},
						{
							"name": "c5",
							"dataSource": "This.CostoUnit",
							"width": 80,
							"header": {
								"name": "hc5",
								"text": "Costo"
							}
						},
						{
							"name": "c6",
							"dataSource": "This.TipoOrigen",
							"width": 80,
							"header": {
								"name": "hc6",
								"text": "Origen"
							}
						},
						{
							"name": "c7",
							"dataSource": "This.sucursal.Nombre",
							"width": 115,
							"header": {
								"name": "hc7",
								"text": "Sucursal"
							}
						},
						{
							"name": "c8",
							"dataSource": "This.Anulacion",
							"width": 60,
							"header": {
								"name": "hc8",
								"text": "Reverso"
							}
						}
					]
				},
				"bCerrar": {
					"type": "button",
					"text": "Cerrar",
					"left": 790,
					"top": 515,
					"width": 100,
					"height": 26,
					"events": [
						"onClick"
					],
					"action": "cancel"
				}
			}
		}
	],
	"method": "method.4dm"
}