{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowTitle": "Plan de cuentas",
	"events": [
		"onLoad"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"titulo": {
					"type": "text",
					"text": "Plan de cuentas - registro",
					"left": 20,
					"top": 8,
					"width": 400,
					"height": 26,
					"fontWeight": "bold",
					"fontSize": 16
				},
				"l_Codigo": {
					"type": "text",
					"text": "Código",
					"left": 20,
					"top": 52,
					"width": 190,
					"height": 20
				},
				"i_Codigo": {
					"type": "input",
					"dataSource": "Form.entidad.Codigo",
					"dataSourceTypeHint": "text",
					"left": 215,
					"top": 50,
					"width": 200,
					"height": 22,
					"enterable": true
				},
				"v_Ayuda": {
					"type": "input",
					"dataSource": "Form.ayuda",
					"dataSourceTypeHint": "text",
					"left": 20,
					"top": 80,
					"width": 540,
					"height": 22,
					"enterable": false
				},
				"l_Nombre": {
					"type": "text",
					"text": "Nombre",
					"left": 20,
					"top": 114,
					"width": 190,
					"height": 20
				},
				"i_Nombre": {
					"type": "input",
					"dataSource": "Form.entidad.Nombre",
					"dataSourceTypeHint": "text",
					"left": 215,
					"top": 112,
					"width": 345,
					"height": 22,
					"enterable": true
				},
				"l_Naturaleza": {
					"type": "text",
					"text": "Naturaleza",
					"left": 20,
					"top": 148,
					"width": 190,
					"height": 20
				},
				"i_Naturaleza": {
					"type": "input",
					"dataSource": "Form.entidad.Naturaleza",
					"dataSourceTypeHint": "text",
					"left": 215,
					"top": 146,
					"width": 120,
					"height": 22,
					"enterable": false
				},
				"b_Naturaleza": {
					"type": "button",
					"text": "Elegir...",
					"left": 345,
					"top": 144,
					"width": 90,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/b_Naturaleza.4dm"
				},
				"l_Nivel": {
					"type": "text",
					"text": "Nivel / Grupo",
					"left": 20,
					"top": 182,
					"width": 190,
					"height": 20
				},
				"v_Nivel": {
					"type": "input",
					"dataSource": "Form.entidad.Nivel",
					"dataSourceTypeHint": "number",
					"left": 215,
					"top": 180,
					"width": 60,
					"height": 22,
					"enterable": false
				},
				"v_Grupo": {
					"type": "input",
					"dataSource": "Form.entidad.Grupo",
					"dataSourceTypeHint": "number",
					"left": 285,
					"top": 180,
					"width": 60,
					"height": 22,
					"enterable": false
				},
				"c_Movimiento": {
					"type": "checkbox",
					"text": "Cuenta de movimiento (recibe asientos)",
