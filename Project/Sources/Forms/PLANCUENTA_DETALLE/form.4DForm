					"events": [
						"onClick"
					],
					"method": "ObjectMethods/bGuardar.4dm"
				},
				"bCancelar": {
					"type": "button",
					"text": "Cancelar",
					"left": 460,
					"top": 290,
					"width": 100,
					"height": 26,
