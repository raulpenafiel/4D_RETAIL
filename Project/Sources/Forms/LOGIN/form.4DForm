{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowTitle": "Iniciar sesión",
	"width": 440,
	"height": 200,
	"events": [
		"onLoad"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"tMensaje": {
					"type": "input",
					"dataSource": "Form.mensaje",
					"dataSourceTypeHint": "text",
					"left": 20,
					"top": 12,
					"width": 400,
					"height": 22,
					"enterable": false,
					"borderStyle": "none",
					"fill": "transparent",
					"fontWeight": "bold"
				},
				"lAcceso": {
					"type": "text",
					"text": "Usuario (usuario@dominio)",
					"left": 20,
					"top": 56,
					"width": 170,
					"height": 20
				},
				"iAcceso": {
					"type": "input",
					"dataSource": "Form.acceso",
					"dataSourceTypeHint": "text",
					"left": 195,
					"top": 54,
					"width": 225,
					"height": 22,
					"enterable": true
				},
				"lClave": {
					"type": "text",
					"text": "Clave",
					"left": 20,
					"top": 92,
					"width": 170,
					"height": 20
				},
				"iClave": {
					"type": "input",
					"dataSource": "Form.clave",
					"dataSourceTypeHint": "text",
					"left": 195,
					"top": 90,
					"width": 225,
					"height": 22,
					"enterable": true,
					"fontFamily": "%password"
				},
				"bAceptar": {
					"type": "button",
					"text": "Aceptar",
					"left": 210,
					"top": 150,
					"width": 100,
					"height": 26,
					"defaultButton": true,
					"action": "accept"
				},
				"bCancelar": {
					"type": "button",
					"text": "Cancelar",
					"left": 320,
					"top": 150,
					"width": 100,
					"height": 26,
					"action": "cancel"
				}
			}
		}
	],
	"method": "method.4dm"
}