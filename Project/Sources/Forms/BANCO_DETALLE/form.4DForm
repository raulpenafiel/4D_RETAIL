					"left": 215,
					"top": 84,
					"width": 200,
					"height": 22,
					"enterable": true
				},
				"l_Tipo": {
					"type": "text",
					"text": "Tipo de cuenta",
					"left": 20,
					"top": 120,
					"width": 190,
					"height": 20
				},
				"b_Tipo": {
					"type": "button",
