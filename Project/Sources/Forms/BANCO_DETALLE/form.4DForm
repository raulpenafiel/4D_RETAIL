					"left": 215,
					"top": 50,
					"width": 340,
					"height": 22,
					"enterable": true
				},
				"l_NumeroCuenta": {
					"type": "text",
					"text": "Número de cuenta",
					"left": 20,
					"top": 86,
					"width": 190,
					"height": 20
				},
				"i_NumeroCuenta": {
					"type": "input",
