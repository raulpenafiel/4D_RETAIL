{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowTitle": "Bancos",
	"events": [
		"onLoad"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
